# ==========================================
# ALIGN RESUME STUDIO - ENVIRONMENT CONFIG
# ==========================================

# --- Backend Configuration ---
# Google Gemini API key (recommended, free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (optional alternative)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API key (optional alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Active LLM provider: gemini | groq | openai | local
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Backend Host & Port
HOST=0.0.0.0
PORT=8000

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
