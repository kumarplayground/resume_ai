# ==========================================================
# ALIGN RESUME STUDIO - ENVIRONMENT CONFIGURATION
# ==========================================================

# ----------------------------------------------------------
# 1. RENDER (BACKEND) ENVIRONMENT VARIABLES
# ----------------------------------------------------------
# Set these in your Render Dashboard: Environment
GEMINI_API_KEY=your_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.0-flash

# Optional alternative LLMs
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Render backend host/port (Render sets PORT automatically)
HOST=0.0.0.0
PORT=8000

# Frontend URL for CORS (set to your Vercel deployment URL)
# Example: https://your-resume-ai.vercel.app
FRONTEND_URL=https://resume-ai-five-smoky.vercel.app

# ----------------------------------------------------------
# 2. VERCEL (FRONTEND) ENVIRONMENT VARIABLES
# ----------------------------------------------------------
# Set these in your Vercel Project Settings: Environment Variables
# Both variables can point to your live Render backend URL:
NEXT_PUBLIC_API_URL=https://resume-ai-gxgz.onrender.com/api
BACKEND_INTERNAL_URL=https://resume-ai-gxgz.onrender.com

